{
  "note": "Written by hand from the story 4 plan's Design Notes (Restart rules, Two handshakes at once), with no crypto. One scheduler per (peer, relay). Each step happens at at_mono_ms. The runner numbers starts 1, 2, 3 in order and begins each with that number as its counter (or with the step's begin_counter), unless the step says store_fails (no begin, so no hs1). hs2_ok:N is a completed hs2 for the handshake with counter N. tick polls the scheduler. expect.start is the start number emitted in the step, or null; expect.hanging lists the counters whose hanging trigger fired in the step (empty when absent); expect.session (the adopted counter) and expect.deadline (the next deadline) are checked when present.",
  "constants": {
    "window_ms": 10000,
    "retry_ms": 10000,
    "hanging_ms": 10000,
    "max_age_ms": 86400000,
    "max_outstanding": 4,
    "outstanding_ttl_ms": 86400000,
    "nonce_ceiling": 4294967296
  },
  "scripts": [
    {
      "name": "Mac online with no session starts a handshake, its retry due 10 s later",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1, "session": null, "deadline": 10000 } }
      ]
    },
    {
      "name": "each trigger starts a handshake once the window is open; pull to refresh only with no session",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1, "deadline": 10000 } },
        { "at_mono_ms": 1000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1, "deadline": 86401000 } },
        { "at_mono_ms": 20000, "event": "trigger:foreground", "expect": { "start": 2, "deadline": 30000 } },
        { "at_mono_ms": 21000, "event": "hs2_ok:2", "expect": { "start": null, "session": 2, "deadline": 86421000 } },
        { "at_mono_ms": 40000, "event": "trigger:rehandshake", "expect": { "start": 3 } },
        { "at_mono_ms": 41000, "event": "hs2_ok:3", "expect": { "start": null, "session": 3 } },
        { "at_mono_ms": 60000, "event": "trigger:bad_frame", "expect": { "start": 4 } },
        { "at_mono_ms": 61000, "event": "hs2_ok:4", "expect": { "start": null, "session": 4, "deadline": 86461000 } },
        { "at_mono_ms": 80000, "event": "trigger:pull_to_refresh", "expect": { "start": null, "session": 4, "deadline": 86461000 } },
        { "at_mono_ms": 90000, "event": "end", "expect": { "start": null, "session": null, "deadline": null } },
        { "at_mono_ms": 100000, "event": "trigger:pull_to_refresh", "expect": { "start": 5, "deadline": 110000 } }
      ]
    },
    {
      "name": "a burst at launch is one handshake: the session completing after it drops the deferred start",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1, "deadline": 10000 } },
        { "at_mono_ms": 50, "event": "trigger:foreground", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 80, "event": "trigger:mac_online", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 400, "event": "hs2_ok:1", "expect": { "start": null, "session": 1, "deadline": 86400400 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": null, "session": 1 } }
      ]
    },
    {
      "name": "a burst with no answer: the retry and the deferred start fall due together and give one start",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:foreground", "expect": { "start": 1 } },
        { "at_mono_ms": 5000, "event": "trigger:mac_online", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 9999, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2, "deadline": 20000 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": 3, "deadline": null } },
        { "at_mono_ms": 30000, "event": "tick", "expect": { "start": null } }
      ]
    },
    {
      "name": "a trigger raised after the session completed still starts at the window's end",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 1000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1 } },
        { "at_mono_ms": 3000, "event": "trigger:bad_frame", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2, "session": 1, "deadline": 20000 } }
      ]
    },
    {
      "name": "the Mac never answers after one trigger: exactly 2 starts in 60 s",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2, "deadline": null } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 30000, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 40000, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 50000, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 60000, "event": "tick", "expect": { "start": null, "session": null } }
      ]
    },
    {
      "name": "a lost newer hs2: one hanging trigger, C gets its ordinary retry, and B raises no second",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 11000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1, "deadline": 20000 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": 3, "hanging": [2], "deadline": 30000 } },
        { "at_mono_ms": 30000, "event": "tick", "expect": { "start": 4, "hanging": [], "deadline": 86411000 } },
        { "at_mono_ms": 40000, "event": "tick", "expect": { "start": null, "hanging": [] } },
        { "at_mono_ms": 60000, "event": "tick", "expect": { "start": null, "hanging": [], "session": 1 } }
      ]
    },
    {
      "name": "a lost newer hs2 converges on a fresh handshake",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 11000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": 3, "hanging": [2] } },
        { "at_mono_ms": 21000, "event": "hs2_ok:3", "expect": { "start": null, "session": 3, "deadline": 86421000 } },
        { "at_mono_ms": 30000, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 40000, "event": "tick", "expect": { "start": null, "session": 3 } }
      ]
    },
    {
      "name": "a hanging trigger and a retry due at the same moment give one start",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:foreground", "expect": { "start": 1 } },
        { "at_mono_ms": 5000, "event": "trigger:mac_online", "expect": { "start": null } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2, "deadline": 20000 } },
        { "at_mono_ms": 12000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1, "deadline": 20000 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": 3, "hanging": [2], "deadline": 30000 } },
        { "at_mono_ms": 30000, "event": "tick", "expect": { "start": 4, "deadline": 86412000 } }
      ]
    },
    {
      "name": "a store write that fails: the start still counts, and the retry gets its own allocation",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "store_fails": true, "expect": { "start": 1, "deadline": 10000 } },
        { "at_mono_ms": 5000, "event": "trigger:foreground", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 10500, "event": "hs2_ok:1", "expect": { "start": null, "session": null } },
        { "at_mono_ms": 11000, "event": "hs2_ok:2", "expect": { "start": null, "session": 2 } }
      ]
    },
    {
      "name": "a store write that fails, then its retry",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "store_fails": true, "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2, "deadline": null } },
        { "at_mono_ms": 10500, "event": "hs2_ok:2", "expect": { "start": null, "session": 2 } }
      ]
    },
    {
      "name": "a store write that fails twice: the start and its one retry, then nothing",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "store_fails": true, "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "store_fails": true, "expect": { "start": 2 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": null, "deadline": null } }
      ]
    },
    {
      "name": "hs2 in order A then B: the newer is adopted",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 11000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1, "deadline": 20000 } },
        { "at_mono_ms": 11500, "event": "hs2_ok:2", "expect": { "start": null, "session": 2, "deadline": 86411500 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": null, "hanging": [], "session": 2 } }
      ]
    },
    {
      "name": "hs2 in order B then A: B stays",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 11000, "event": "hs2_ok:2", "expect": { "start": null, "session": 2, "deadline": 86411000 } },
        { "at_mono_ms": 11500, "event": "hs2_ok:1", "expect": { "start": null, "session": 2 } },
        { "at_mono_ms": 20000, "event": "tick", "expect": { "start": null, "hanging": [], "session": 2 } }
      ]
    },
    {
      "name": "the stuck state: A sent, retry B lost, the Mac answers A: the phone adopts A",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 10500, "event": "hs2_ok:1", "expect": { "start": null, "session": 1 } }
      ]
    },
    {
      "name": "24 h after the session completed",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 1000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1, "deadline": 86401000 } },
        { "at_mono_ms": 86400999, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 86401000, "event": "tick", "expect": { "start": 2, "session": 1, "deadline": 86411000 } },
        { "at_mono_ms": 86401500, "event": "hs2_ok:2", "expect": { "start": null, "session": 2, "deadline": 172801500 } }
      ]
    },
    {
      "name": "both frame ceilings: the send nonce reaching 2^32, and a received nonce of 2^32-1",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 1000, "event": "hs2_ok:1", "expect": { "start": null, "session": 1 } },
        { "at_mono_ms": 20000, "event": "sent_nonce:4294967294", "expect": { "start": null } },
        { "at_mono_ms": 20001, "event": "sent_nonce:4294967295", "expect": { "start": 2 } },
        { "at_mono_ms": 21000, "event": "hs2_ok:2", "expect": { "start": null, "session": 2 } },
        { "at_mono_ms": 40000, "event": "recv_nonce:4294967294", "expect": { "start": null } },
        { "at_mono_ms": 40001, "event": "recv_nonce:4294967295", "expect": { "start": 3 } }
      ]
    },
    {
      "name": "pull to refresh with no session inside the window is deferred",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:pull_to_refresh", "expect": { "start": 1 } },
        { "at_mono_ms": 3000, "event": "trigger:pull_to_refresh", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2, "deadline": 20000 } }
      ]
    },
    {
      "name": "at most 4 outstanding handshakes, the oldest dropped; adoption arms the newer ones",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 20000, "event": "trigger:foreground", "expect": { "start": 3 } },
        { "at_mono_ms": 30000, "event": "tick", "expect": { "start": 4 } },
        { "at_mono_ms": 40000, "event": "trigger:foreground", "expect": { "start": 5 } },
        { "at_mono_ms": 41000, "event": "hs2_ok:1", "expect": { "start": null, "session": null } },
        { "at_mono_ms": 42000, "event": "hs2_ok:2", "expect": { "start": null, "session": 2, "deadline": 30000 } },
        { "at_mono_ms": 43000, "event": "tick", "expect": { "start": null, "hanging": [3, 4], "deadline": 50000 } },
        { "at_mono_ms": 50000, "event": "tick", "expect": { "start": 6, "hanging": [5], "deadline": 60000 } },
        { "at_mono_ms": 51000, "event": "hs2_ok:3", "expect": { "start": null, "session": 3, "deadline": 60000 } },
        { "at_mono_ms": 52000, "event": "tick", "expect": { "start": null, "hanging": [] } },
        { "at_mono_ms": 60000, "event": "tick", "expect": { "start": 7, "hanging": [6], "deadline": 70000 } }
      ]
    },
    {
      "name": "an hs2 at or below the session's counter is never adopted",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "begin_counter": 10, "expect": { "start": 1 } },
        { "at_mono_ms": 1000, "event": "hs2_ok:10", "expect": { "start": null, "session": 10 } },
        { "at_mono_ms": 20000, "event": "trigger:foreground", "begin_counter": 7, "expect": { "start": 2 } },
        { "at_mono_ms": 21000, "event": "hs2_ok:7", "expect": { "start": null, "session": 10 } },
        { "at_mono_ms": 22000, "event": "hs2_ok:10", "expect": { "start": null, "session": 10 } }
      ]
    },
    {
      "name": "outstanding handshakes expire after 24 h",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } },
        { "at_mono_ms": 86410000, "event": "tick", "expect": { "start": null } },
        { "at_mono_ms": 86410001, "event": "hs2_ok:2", "expect": { "start": null, "session": null } }
      ]
    },
    {
      "name": "end drops the session and the outstanding handshakes, but not the window",
      "steps": [
        { "at_mono_ms": 0, "event": "trigger:mac_online", "expect": { "start": 1 } },
        { "at_mono_ms": 1000, "event": "end", "expect": { "start": null, "session": null, "deadline": null } },
        { "at_mono_ms": 2000, "event": "hs2_ok:1", "expect": { "start": null, "session": null } },
        { "at_mono_ms": 5000, "event": "trigger:foreground", "expect": { "start": null, "deadline": 10000 } },
        { "at_mono_ms": 10000, "event": "tick", "expect": { "start": 2 } }
      ]
    }
  ],
  "counters": [
    { "why": "nothing sent yet: the wall clock", "wall_ms": 1760000000000, "last_sent": null, "expect": 1760000000000 },
    { "why": "nothing sent and a zero clock", "wall_ms": 0, "last_sent": null, "expect": 0 },
    { "why": "a clock set back", "wall_ms": 1000, "last_sent": 1760000000000, "expect": 1760000000001 },
    { "why": "a clock equal to last_sent", "wall_ms": 5000, "last_sent": 5000, "expect": 5001 },
    { "why": "a clock ahead of last_sent", "wall_ms": 6000, "last_sent": 5000, "expect": 6000 },
    { "why": "last_sent at 2^53-2", "wall_ms": 0, "last_sent": 9007199254740990, "expect": 9007199254740991 },
    { "why": "last_sent at 2^53-1: exhausted", "wall_ms": 0, "last_sent": 9007199254740991, "expect": "error" },
    { "why": "a wall clock of 2^53-1", "wall_ms": 9007199254740991, "last_sent": null, "expect": 9007199254740991 }
  ]
}
