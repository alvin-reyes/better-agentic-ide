{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    // Check @ade/protocol at its node_modules/@ade/protocol link, so its @noble
    // imports resolve from the app's node_modules, as in Metro and Jest.
    "preserveSymlinks": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
