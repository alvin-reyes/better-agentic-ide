<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice dictation in the scratchpad uses the Web Speech API, which needs
	     microphone capture. Without this the hardened runtime denies access and
	     recognition fails with a "not-allowed" error. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
